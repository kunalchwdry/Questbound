# ---------------------------------------------------------------------------
# Database
#
# Local Postgres (default for `npm run dev` with a local server):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Supabase — use the "Transaction" pooler string (Supabase Dashboard →
# Project Settings → Database → Connection string → Transaction pooler,
# port 6543). Percent-encode special characters in the password
# (# -> %23, @ -> %40, etc.). No sslmode param is needed; the app enables
# TLS for any non-local host automatically.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Public site URL – used for SEO metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase Auth (GoTrue)
# Create a project at https://supabase.com. Keys: Project Settings → API.
# The "publishable"/anon key is safe to expose in the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server-only equivalents (same values; used by route handlers)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional service-role key for admin scripts only — NEVER prefix with NEXT_PUBLIC
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# The Oracle (emotion-aware companion)
#
# ZERO SETUP: with no configuration below, the Oracle already runs on a chain
# of free, keyless OpenAI-compatible models (LLM7 → OVHcloud → Pollinations →
# Kilo), failing over automatically, and finally to the on-device model.
# See RESEARCH.md. A keyed provider always takes precedence.
# ---------------------------------------------------------------------------
# Pick: a keyless id (llm7|ovh-nemo|pollinations|kilo-nemotron|ovh|kilo),
#       a keyed id (gemini|groq|nvidia|openai|custom), or "local".
AI_PROVIDER=
AI_ALLOW_KEYLESS=true
AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Secret vault
#
# Master key used to AES-256-GCM encrypt each hero's custom LLM API key
# (Dashboard → Settings → AI / LLM) before it is stored in Postgres.
# Generate one with:  openssl rand -base64 48
# If unset, a key is derived from other server-side secrets (DATABASE_URL),
# which protects against DB dumps but does not survive rotating those values.
# Changing this value makes previously stored LLM keys unreadable — heroes
# simply re-enter them.
# ---------------------------------------------------------------------------
# APP_ENCRYPTION_KEY=
